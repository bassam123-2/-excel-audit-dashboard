# ── Django Settings ───────────────────────────────────────────────────────────────────────
# Module path only. Do not append gunicorn or other commands on this line.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true # change to false in production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost # change to your domain in production
ERROR_LOGGING_ENABLED=false # change to true in production

# ── Database Settings ───────────────────────────────────────────────────────────────────────
DB_NAME=excel_dashboard # change to your database name in production
DB_USER=root # change to your database user in production
DB_PASSWORD= # change to your database password in production (leave empty if you don't have a password)
DB_HOST=127.0.0.1 # change to your database host in production
DB_PORT=3306 # change to your database port in production   

# ── SMTP Settings ───────────────────────────────────────────────────────────────────────
AI_EXCEL_SMTP_HOST=smtp.gmail.com # change to your SMTP host in production
AI_EXCEL_SMTP_PORT=587 # change to your SMTP port in production
AI_EXCEL_SMTP_USER=noreply@YourDomain.com # change to your SMTP user (email address) in production
AI_EXCEL_SMTP_PASSWORD=your-smtp-password # change to your SMTP password in production
AI_EXCEL_SMTP_FROM=noreply@YourDomain.com # change to your SMTP email address from in production
AI_EXCEL_SMTP_FROM_NAME="Audit Dashboard" # change to your SMTP subject from name in production
AI_EXCEL_SMTP_USE_TLS=true # change to your SMTP use TLS in production (true or false)

# ── Public site URL (HTTPS links in workflow/credentials emails + logo) ──
PUBLIC_SITE_URL=https://YourDomain.com
EMAIL_LOGO_URL=https://YourDomain.com/static/logos/YourLogoName.png

# ── Idle Session Timeout ───────────────────────────────────────────────────────────────────────
IDLE_SESSION_TIMEOUT_SECONDS=1800 # 30 minutes

# ── Redis (required for OTP / shared cache across workers) ───────────────────────────────────

# VPS / production (Redis 6+ from apt — leave REDIS_PROTOCOL unset):
REDIS_URL=redis://127.0.0.1:6379/1
# REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@127.0.0.1:6379/1

# Local Laragon only (Redis 3.2 — add this line if login shows unknown command HELLO):
REDIS_PROTOCOL=2

# ── Deploy script (VPS only — scripts/deploy.sh reads these from .env) ───────────────────────
# Copy template once: cp scripts/deploy.example.sh scripts/deploy.sh && chmod +x scripts/deploy.sh
DEPLOY_PROJECT_ROOT=/home/your-user/your-domain.com/excel-audit-dashboard
DEPLOY_VENV_DIR=venv
DEPLOY_GIT_BRANCH=techs4ever
DEPLOY_APP_SERVICE=excel-dashboard
DEPLOY_REDIS_SERVICE=redis
# Optional — defaults to ${PUBLIC_SITE_URL}/api/version when unset:
# DEPLOY_HEALTH_URL=https://YourDomain.com/api/version
